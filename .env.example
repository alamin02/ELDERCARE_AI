# ==============================================================
# ElderCare AI Environment Configuration Template
# Copy this file to .env for local deployment
# NEVER commit .env to version control!
# ==============================================================

# Application
PROJECT_NAME="ElderCare AI"
PORT=8080

# Security
SECRET_KEY="replace-this-with-a-random-secret-key-for-jwt-tokens"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite local development database
DATABASE_URL="sqlite:///./eldercare.db"
# Production Cloud Run with PostgreSQL (Cloud SQL):
# DATABASE_URL="postgresql://user:password@/eldercare?host=/cloudsql/project:region:instance"

# Google Gemini API
# If left empty, ElderCare AI automatically runs its deterministic clinical reasoning engine
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Notification Dispatcher
# When true, all SOS alerts are labeled as simulated_sent to prevent fake delivery claims
SIMULATED_NOTIFICATION_MODE=true
